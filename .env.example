# App
APP_NAME=Global Deals Network
APP_ENV=development

# Temporary development URL
APP_URL=https://deals.tickmarktools.com

# Public website base URL. Canonical URLs, sitemaps and Open Graph URLs on
# the server-rendered SEO pages (/product/:slug, /category/:slug,
# /store/:slug, /sitemap.xml, /robots.txt) are built from it. Defaults to
# APP_URL.
SITE_URL=

# Base URL of THIS API as browsers see it. Used for the "Shop" links on SEO
# pages (the central affiliate redirect /api/v1/redirect/deal/:id). Leave
# empty only if the pages are served from the same origin as the API; in
# production set it to the API's public URL.
PUBLIC_API_URL=

# Market used for the public SEO pages and sitemaps (USA first).
DEFAULT_MARKET_CODE=US

# API server
API_VERSION=v1
PORT=8080
HOST=0.0.0.0

# Database
DATABASE_URL=

# Telegram
# TELEGRAM_WEBHOOK_SECRET is your own generated value, set via
# setWebhook's secret_token (see scripts/telegram-set-webhook.ts) and
# checked against Telegram's X-Telegram-Bot-Api-Secret-Token header
# on every webhook call. TELEGRAM_CHANNEL_ID is the GDN Channel's
# chat id, used only by the manual scripts/telegram-post-deal.ts
# script (no public API posts to the Channel yet).
# TELEGRAM_BOT_TOKEN also verifies Mini App initData for user-scoped
# routes (watchlist, image search); without it those routes reject every
# request.
# TELEGRAM_INIT_DATA_MAX_AGE_SECONDS is how long a Mini App initData
# credential stays valid (60 - 604800, default 86400 = 1 day).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHANNEL_ID=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400

# Affiliate
# AMAZON_AFFILIATE_TAG is the Amazon Associates tracking tag (e.g.
# "yoursite-20"). AMAZON_AFFILIATE_ENABLED is a separate explicit
# go-live switch, so a tag can be configured without the system
# generating live affiliate links until this is set to true.
AMAZON_AFFILIATE_TAG=
AMAZON_AFFILIATE_ENABLED=false
# Reserved for a future Amazon Product Advertising API integration
# (see GDN_Stage1D_Amazon_Affiliate_Commerce_Foundation.md,
# "Conversion / Revenue") - not read by any code yet. Stage 1D's
# affiliate links use only AMAZON_AFFILIATE_TAG above.
AMAZON_API_KEY=
AMAZON_API_SECRET=

# Analytics
ANALYTICS_ID=

# Security
SESSION_SECRET=

# Internal API key. REQUIRED for every write (POST/PATCH/PUT/DELETE)
# under /api/v1 - callers must send "Authorization: Bearer <key>".
# GET/HEAD/OPTIONS stay public, and /api/v1/telegram/webhook keeps its
# own TELEGRAM_WEBHOOK_SECRET authentication. If this is unset or
# shorter than 32 characters, ALL protected writes are rejected with
# 401 (fail closed). Generate with: openssl rand -hex 32
# Never commit a real value - set it as a platform secret (Render) and
# in your private local .env only. See
# docs/implementation/GDN_Internal_API_Security.md.
GDN_INTERNAL_API_KEY=

# CORS - comma-separated list of browser origins allowed to call this
# API cross-origin. Defaults to APP_URL if unset. Add the Telegram
# Mini App's frontend origin here once it is built and deployed.
CORS_ALLOWED_ORIGINS=

# Basic per-IP rate limiting. Defaults are generous (300 requests per
# 60s per IP) - tune per environment, no code change required.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
